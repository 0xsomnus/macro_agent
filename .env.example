# Copy only for local development; no dotenv loader is assumed.
DJANGO_SETTINGS_MODULE=macro_agent.web.local_settings
MACRO_DB_NAME=macro_agent_dev
MACRO_DB_USER=macro_agent
MACRO_DB_HOST=127.0.0.1
MACRO_DB_PORT=5432
MACRO_DB_PASSWORD=replace-with-local-database-password
# Explicit gate for fictional bootstrap commands, never production settings.
MACRO_ALLOW_SYNTHETIC_SETUP=1
