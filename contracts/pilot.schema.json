{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:macro-agent:pilot-fixture:0.1.0",
  "title": "Synthetic paper-pilot contract fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "synthetic", "context_bindings", "context_versions", "thesis", "interpretation", "events", "accumulation"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "synthetic": {"const": true},
    "context_bindings": {"type": "object", "additionalProperties": false, "required": ["source_manifest_version", "coverage_contract_version", "exposure_version", "macro_context_version", "knowledge_version", "rule_version"], "properties": {
      "source_manifest_version": {"$ref": "#/$defs/id"}, "coverage_contract_version": {"$ref": "#/$defs/id"},
      "exposure_version": {"$ref": "#/$defs/id"}, "macro_context_version": {"$ref": "#/$defs/id"},
      "knowledge_version": {"$ref": "#/$defs/id"}, "rule_version": {"$ref": "#/$defs/id"}
    }},
    "context_versions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/context"}},
    "thesis": {"$ref": "#/$defs/thesis"},
    "interpretation": {"$ref": "#/$defs/interpretation"},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}, "minItems": 1},
    "accumulation": {"type": "object", "additionalProperties": false, "required": ["window_seconds", "threshold", "observations"], "properties": {
      "window_seconds": {"type": "integer", "minimum": 1},
      "threshold": {"type": "number", "exclusiveMinimum": 0},
      "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}}
    }}
  },
  "$defs": {
    "context": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "known_at", "content"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "kind": {"type": "string", "minLength": 1},
      "known_at": {"$ref": "#/$defs/timestamp"}, "content": {"type": "object"}
    }},
    "timestamp": {"type": "string", "format": "date-time"},
    "id": {"type": "string", "minLength": 1},
    "thesis": {"type": "object", "additionalProperties": false, "required": ["id", "owner_id", "text", "approved_at"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "owner_id": {"$ref": "#/$defs/id"},
      "text": {"type": "string", "minLength": 1}, "approved_at": {"$ref": "#/$defs/timestamp"}
    }},
    "interpretation": {"type": "object", "additionalProperties": false, "required": ["id", "drivers", "horizon", "invalidation_signposts"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "drivers": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1, "uniqueItems": true},
      "horizon": {"type": "string", "minLength": 1},
      "invalidation_signposts": {"type": "array", "items": {"type": "string", "minLength": 1}}
    }},
    "event": {"type": "object", "additionalProperties": false, "required": ["event_id", "revision", "public_available_at", "system_received_at", "known_at", "source_id", "source_contract_version", "family", "facts", "screening"], "properties": {
      "event_id": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1},
      "public_available_at": {"$ref": "#/$defs/timestamp"}, "system_received_at": {"$ref": "#/$defs/timestamp"}, "known_at": {"$ref": "#/$defs/timestamp"},
      "source_id": {"$ref": "#/$defs/id"}, "source_contract_version": {"$ref": "#/$defs/id"},
      "family": {"enum": ["scheduled_macro", "unexpected_news", "market_context"]},
      "facts": {"type": "object"}, "screening": {"$ref": "#/$defs/screening"}
    }},
    "screening": {"type": "object", "additionalProperties": false, "required": ["resolved", "credible", "urgent", "potential_severity", "thesis_impact", "trade_impact", "plausible_transmission", "broad_disruption", "novel", "classifier_available"], "properties": {
      "resolved": {"type": "boolean"}, "credible": {"type": "boolean"}, "urgent": {"type": "boolean"},
      "potential_severity": {"enum": ["low", "high"]},
      "thesis_impact": {"type": "boolean"}, "trade_impact": {"type": "boolean"},
      "plausible_transmission": {"type": "boolean"}, "broad_disruption": {"type": "boolean"},
      "novel": {"type": "boolean"}, "classifier_available": {"type": "boolean"}
    }},
    "observation": {"type": "object", "additionalProperties": false, "required": ["event_id", "driver_id", "known_at", "signed_fixture_weight"], "properties": {
      "event_id": {"$ref": "#/$defs/id"}, "driver_id": {"$ref": "#/$defs/id"},
      "known_at": {"$ref": "#/$defs/timestamp"}, "signed_fixture_weight": {"type": "number"}
    }}
  }
}
